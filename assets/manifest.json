{
  "styles": {
    "main.css": "styles/main.scss",
    "login.css": "styles/login.scss",
    "fontawesome.css": "styles/fontawesome.scss"
  },
  "scripts": {
    "main.js": "scripts/main.js",
    "critical-styles.js": "scripts/critical-styles.js",
    "critical-form-gate.js": "scripts/critical-form-gate.js"
  },
  "performance": {
    "mobileBreakpoint": 576,
    "critical": {
      "version": 1,
      "id": "skye-shell-v1",
      "filename": "main-critical.css",
      "placeholder": "__SKYE_THEME_DIST__",
      "classes": [
        "active",
        "collapse",
        "collapsed",
        "collapsing",
        "show",
        "screen-reader-text",
        "visually-hidden",
        "visually-hidden-focusable",
        "skip-link",
        "nav-open"
      ],
      "prefixes": [
        "navbar",
        "nav-",
        "dropdown",
        "brand",
        "page-header"
      ],
      "source_paths": [
        "base.php",
        "components/header/",
        "components/navigation/",
        "components/pageheader/"
      ]
    },
    "icons": [],
    "fonts": []
  }
}
