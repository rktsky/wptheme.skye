{
  "name": "skye",
  "version": "3.5.0",
  "private": true,
  "description": "Classic WordPress starter theme assets",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=14.21.3 <15",
    "npm": ">=6.14.18 <7"
  },
  "packageManager": "npm@6.14.18",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test:build": "node --test tests/build.test.mjs",
    "test:performance": "node tests/critical-loader.test.cjs",
    "lint:js": "node tools/check-assets.mjs js",
    "lint:style": "node tools/check-assets.mjs style",
    "test:release": "node --test tests/release.test.mjs"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@rollup/plugin-node-resolve": "7.1.3",
    "bootstrap": "6.0.0-alpha.1",
    "chokidar": "4.0.3",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "postcss-value-parser": "4.2.0",
    "rollup": "2.80.0",
    "sass": "1.99.0",
    "terser": "5.51.2",
    "lightningcss": "1.31.1"
  }
}
